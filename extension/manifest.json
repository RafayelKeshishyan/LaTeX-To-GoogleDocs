{
  "manifest_version": 3,
  "name": "LaTeX for Google Docs",
  "version": "2.12.5",
  "description": "Accessible LaTeX equation editor for Google Docs with keyboard and screen reader support.",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite",
    "tts",
    "webNavigation"
  ],
  "host_permissions": [
    "https://docs.google.com/document/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "exclude_matches": [
        "https://docs.google.com/document/*/mobilebasic*",
        "https://docs.google.com/document/u/*/d/*/mobilebasic*"
      ],
      "js": ["content/page-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://docs.google.com/*",
        "https://*.googleusercontent.com/*"
      ],
      "js": ["content/addon-focus-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://docs.google.com/document/*"],
      "exclude_matches": [
        "https://docs.google.com/document/*/mobilebasic*",
        "https://docs.google.com/document/u/*/d/*/mobilebasic*"
      ],
      "js": [
        "content/extension-context.js",
        "lib/insertion-verification.js",
        "content/docs-utils.js",
        "lib/katex/katex.min.js",
        "lib/latex-speech.js",
        "lib/latex-mathml.js",
        "lib/speech-output.js",
        "content/document-bridge.js",
        "content/editor-panel.js",
        "content/equation-navigator.js",
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Open LaTeX Equation Editor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "insert-equation": {
      "description": "Focus the Accessible Equation Editor sidebar"
    },
    "read-equation": {
      "suggested_key": {
        "default": "Ctrl+Shift+R"
      },
      "description": "Read equation at cursor (natural math speech)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/page-main.js",
        "sidepanel/sidepanel.html",
        "sidepanel/sidepanel.css",
        "sidepanel/sidepanel.js",
        "lib/katex/katex.min.css",
        "lib/katex/katex.min.js",
        "lib/katex/fonts/*",
        "lib/latex-speech.js",
        "lib/latex-mathml.js",
        "lib/insertion-verification.js",
        "lib/speech-output.js"
      ],
      "matches": ["https://docs.google.com/*"]
    }
  ]
}
