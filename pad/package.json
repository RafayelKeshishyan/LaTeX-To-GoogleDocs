{
  "name": "digimath-pad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:supabase": "node scripts/check-supabase.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:sr": "node scripts/sr-student-walkthrough.mjs",
    "test:axe": "node scripts/axe-scan.mjs",
    "test:structure": "node scripts/a11y-structure.mjs",
